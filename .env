# =============================================
# KONFIGURASI RUGSCAN v11.3
# =============================================

# SECRET KEY Flask — WAJIB diubah di production!
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-random-secret-key-yang-kuat

# MODE: development / production
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5000

# ══════════════════════════════════════════════
# HELIUS API KEY (GRATIS — Wajib untuk data holder)
# ══════════════════════════════════════════════
# getTokenLargestAccounts dinonaktifkan di public RPC.
# Helius menyediakan akses penuh GRATIS (1 juta kredit/bulan).
#
# Cara mendapatkan key GRATIS (5 menit):
#   1. Buka https://dev.helius.xyz
#   2. Klik "Get Started Free" → daftar dengan email/GitHub
#   3. Di dashboard → copy RPC URL atau API Key
#   4. Tempel di bawah (hanya bagian key-nya, tanpa https://...)
#
# Contoh key: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HELIUS_API_KEY=ebb89962-661b-4477-bcab-149449eb07bf

# ── OPSIONAL: RPC endpoint kustom ───────────────────────────
# Jika punya endpoint sendiri (Alchemy, QuickNode, dsb):
# CUSTOM_RPC_URL=https://your-endpoint-here.com
CUSTOM_RPC_URL=
